{
  "name": "shamcash.js",
  "private": true,
  "description": "Workspace root for the shamcash.js packages (a community JavaScript library for the ShamCash e-payment API)",
  "homepage": "https://github.com/ventstd/shamcash.js#readme",
  "bugs": {
    "url": "https://github.com/ventstd/shamcash.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ventstd/shamcash.js.git"
  },
  "license": "MIT",
  "author": "Venture Studio",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:example": "pnpm --filter example-next build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:packages": "pnpm -r --filter \"./packages/*\" check:package",
    "check:leak": "pnpm --filter client-leak check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "husky": "catalog:"
  }
}
